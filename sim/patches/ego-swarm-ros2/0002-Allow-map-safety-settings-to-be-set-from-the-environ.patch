From e1433426a5fb98bca44086513f109cbc917a881e Mon Sep 17 00:00:00 2001
From: Aaron <aaronsebox@gmail.com>
Date: Mon, 12 Oct 2026 13:42:26 -0700
Subject: [PATCH] Allow map safety settings to be set from the environment

advanced_param.launch.py reads these with the old values as defaults:
- EGO_INFLATION (obstacles_inflation, 0.19 m): obstacle padding.
- EGO_GROUND / EGO_CEIL (ground_height -0.01, virtual_ceil_height 2.9):
  altitude band the planner may use.
- EGO_DEPTH_TIMEOUT (odom_depth_timeout, 1.0 s): slow VMs need ~3.0, or the
  planner emergency-stops with "odom or depth lost".
---
 planner/ego_planner/launch/advanced_param.launch.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/planner/ego_planner/launch/advanced_param.launch.py b/planner/ego_planner/launch/advanced_param.launch.py
index 9979d95..cbdb228 100755
--- a/planner/ego_planner/launch/advanced_param.launch.py
+++ b/planner/ego_planner/launch/advanced_param.launch.py
@@ -150,9 +150,10 @@ def generate_launch_description():
             {'grid_map/local_update_range_x': 5.5},
             {'grid_map/local_update_range_y': 5.5},
             {'grid_map/local_update_range_z': 4.5},
-            {'grid_map/obstacles_inflation': 0.19},
+            {'grid_map/obstacles_inflation': float(os.environ.get('EGO_INFLATION', 0.19))},
+            {'grid_map/odom_depth_timeout': float(os.environ.get('EGO_DEPTH_TIMEOUT', 1.0))},
             {'grid_map/local_map_margin': 10},
-            {'grid_map/ground_height': -0.01},
+            {'grid_map/ground_height': float(os.environ.get('EGO_GROUND', -0.01))},
             # camera parameter
             {'grid_map/cx': cx},
             {'grid_map/cy': cy},
@@ -175,7 +176,7 @@ def generate_launch_description():
             {'grid_map/min_ray_length': 0.1},
             {'grid_map/max_ray_length': 4.5},
             
-            {'grid_map/virtual_ceil_height': 2.9},
+            {'grid_map/virtual_ceil_height': float(os.environ.get('EGO_CEIL', 2.9))},
             {'grid_map/visualization_truncate_height': 1.8},
             {'grid_map/show_occ_time': False},
             {'grid_map/pose_type': 2},
-- 
